{
  "name": "cult",
  "version": "0.0.0",
  "private": true,
  "description": "CULT — private monorepo (MVP 1: Porto Alegre Cultural Discovery)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @cult/web run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b tsconfig.json && pnpm --filter @cult/web run build",
    "dev:api": "pnpm --filter @cult/api dev",
    "dev:web": "pnpm --filter @cult/web dev",
    "dev:worker": "pnpm --filter @cult/worker dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "clean": "tsc -b --clean tsconfig.json && pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
