NODE_ENV=development

DATABASE_URL=postgresql://cult:cult@localhost:5432/cult

API_PORT=3001
WEB_PORT=3000

TICKETMASTER_API_KEY=

# Must be exactly "true" to allow `pnpm ingest:ticketmaster` to PERSIST live Ticketmaster
# data. Retention for real Event Content is not yet legally/commercially cleared — see
# docs/sources/ticketmaster.md and ADR-0013. Leave unset/blank by default.
# `pnpm ingest:ticketmaster:live-smoke` needs no such acknowledgement — it never persists.
TICKETMASTER_LIVE_PERSIST_ACK=

# Do not expose provider secrets as NEXT_PUBLIC_* variables.
