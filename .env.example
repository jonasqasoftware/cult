NODE_ENV=development

DATABASE_URL=postgresql://cult:cult@localhost:5432/cult

API_PORT=3001
WEB_PORT=3000

# Server-side only — apps/web's Server Components and its /api/discovery BFF route read this
# to reach the private Fastify API. Never expose the API base URL to the browser
# (never NEXT_PUBLIC_CULT_API_BASE_URL).
CULT_API_BASE_URL=http://localhost:3001

# Public — used for canonical URLs / OpenGraph / the PWA manifest's start_url resolution.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public, substitutable map tile source (M8 section 33). Defaults to OpenStreetMap's standard
# tile server if unset — acceptable for MVP1/low-volume use per
# https://operations.osmfoundation.org/policies/tiles/. Leave unset for local development.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

TICKETMASTER_API_KEY=

# Must be exactly "true" to allow `pnpm ingest:ticketmaster` to PERSIST live Ticketmaster
# data. Retention for real Event Content is not yet legally/commercially cleared — see
# docs/sources/ticketmaster.md and ADR-0013. Leave unset/blank by default.
# `pnpm ingest:ticketmaster:live-smoke` needs no such acknowledgement — it never persists.
TICKETMASTER_LIVE_PERSIST_ACK=

# Do not expose provider secrets as NEXT_PUBLIC_* variables.
